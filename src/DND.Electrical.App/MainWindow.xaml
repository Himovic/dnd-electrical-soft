<Window x:Class="DND.Electrical.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DND.Electrical.Presentation.ViewModels;assembly=DND.Electrical.Presentation"
        xmlns:ctl="clr-namespace:DND.Electrical.App.Controls"
        Title="{Binding Title}" Width="1600" Height="980" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Style="{StaticResource BaseWindow}" Icon="pack://application:,,,/Assets/dnd-app.ico">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}"/>
        <KeyBinding Key="X" Modifiers="Control" Command="{Binding CutCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DuplicateCommand}"/>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}"/>
        <KeyBinding Key="F8" Command="{Binding ValidateCommand}"/>
        <KeyBinding Key="F7" Command="{Binding ToggleSnapCommand}" CommandParameter="grid"/>
        <KeyBinding Key="F9" Command="{Binding ToggleSnapCommand}" CommandParameter="snap"/>
        <KeyBinding Key="F10" Command="{Binding ToggleSnapCommand}" CommandParameter="ortho"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/>
        <KeyBinding Key="P" Modifiers="Control+Shift" Command="{x:Static ApplicationCommands.Properties}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="FocusSearch"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Properties}" Executed="OpenCommandPalette"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- ===================== Title / ribbon ===================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Header}" Padding="10,6">
            <DockPanel>
                <Image Source="pack://application:,,,/Assets/dnd-logo-256.png" Height="28" Margin="0,0,10,0"/>
                <TextBlock Text="D&amp;D Electrical &amp; Automation Engineering Suite" Foreground="{DynamicResource Brush.HeaderText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PoweredBy}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="12,2,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <TextBox x:Name="SearchBox" Width="300" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search everywhere (Ctrl+F): sheets, devices, wires, cables, PLC tags, help"/>
                    <Button Content="⌘ Commands" Click="OpenCommandPalette" Style="{StaticResource FlatButton}" ToolTip="Command palette (Ctrl+Shift+P)"/>
                    <ToggleButton Content="Dark" IsChecked="{Binding IsDarkTheme}" Margin="4,0" Padding="8,2" ToolTip="Dark theme"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl DockPanel.Dock="Top" x:Name="Ribbon" Background="{DynamicResource Brush.Surface}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border}" Padding="4,2">
            <TabItem Header="Home">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Project" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8A5;" Content="New" Command="{Binding NewProjectCommand}" ToolTip="New project (Ctrl+N)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8E5;" Content="Open" Command="{Binding OpenProjectCommand}" ToolTip="Open project (Ctrl+O)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE74E;" Content="Save" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S) – atomic save with automatic backup"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE792;" Content="Save as" Command="{Binding SaveAsCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE711;" Content="Close" Command="{Binding CloseProjectCommand}"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Clipboard" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7A7;" Content="Undo" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7A6;" Content="Redo" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8C8;" Content="Copy" Command="{Binding CopyCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8C6;" Content="Cut" Command="{Binding CutCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE77F;" Content="Paste" Command="{Binding PasteCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE74D;" Content="Delete" Command="{Binding DeleteCommand}"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Engineering" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE9D5;" Content="Validate" Command="{Binding ValidateCommand}" ToolTip="Validate the project (F8)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8EF;" Content="Calculations" Command="{Binding OpenCalculationsCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE749;" Content="Drawing PDF" Command="{Binding ExportDrawingsPdfCommand}"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Project">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Sheets" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE710;" Content="New sheet" Command="{Binding NewSheetCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8AC;" Content="Rename" Command="{Binding RenameSheetCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE74D;" Content="Delete sheet" Command="{Binding DeleteSheetCommand}"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Project" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE713;" Content="Properties" Command="{Binding ProjectPropertiesCommand}" ToolTip="Customer, company, revision and title block data"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE81C;" Content="New revision" Command="{Binding CreateRevisionCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE81C;" Content="Version history" Command="{Binding VersionHistoryCommand}" ToolTip="Restore a backup"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE723;" Content="Attach file" Command="{Binding AddAttachmentCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xEB9F;" Content="Company logo" Command="{Binding SetCompanyLogoCommand}" ToolTip="Logo shown in title blocks and reports"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8C8;" Content="Duplicate" Command="{Binding DuplicateProjectCommand}" ToolTip="Copy the saved project with a new number"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Archive" Style="{StaticResource RibbonGroup}" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7B8;" Content="Export archive" Command="{Binding ExportArchiveCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8B5;" Content="Import archive" Command="{Binding ImportArchiveCommand}"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Drawing">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Select" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8B0;" Content="Select" Command="{Binding SetToolCommand}" CommandParameter="select" ToolTip="Select / move (Esc)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7C2;" Content="Pan" Command="{Binding SetToolCommand}" CommandParameter="pan" ToolTip="Pan (or middle mouse button)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE9A6;" Content="Zoom all" Command="{Binding ZoomExtentsCommand}" ToolTip="Zoom extents (F)"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Electrical" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8CE;" Content="Wire" Command="{Binding SetToolCommand}" CommandParameter="wire" ToolTip="Draw wires between pins (W). Click a wire to create a T-junction."/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Draw" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE738;" Content="Line" Command="{Binding SetToolCommand}" CommandParameter="line"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE76D;" Content="Polyline" Command="{Binding SetToolCommand}" CommandParameter="polyline"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE739;" Content="Rectangle" Command="{Binding SetToolCommand}" CommandParameter="rectangle"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xEA3A;" Content="Circle" Command="{Binding SetToolCommand}" CommandParameter="circle"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7B5;" Content="Arc" Command="{Binding SetToolCommand}" CommandParameter="arc"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8D2;" Content="Text" Command="{Binding SetToolCommand}" CommandParameter="text"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE9A1;" Content="Dimension" Command="{Binding SetToolCommand}" CommandParameter="dimension"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8BD;" Content="Callout" Command="{Binding SetToolCommand}" CommandParameter="callout"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Modify" Style="{StaticResource RibbonGroup}" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7C2;" Content="Move" Command="{Binding SetToolCommand}" CommandParameter="move"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8C8;" Content="Copy" Command="{Binding SetToolCommand}" CommandParameter="copy"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7AD;" Content="Rotate 90°" Command="{Binding RotateCommand}" ToolTip="Rotate selection by 90° (R)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8AB;" Content="Mirror" Command="{Binding MirrorCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8C9;" Content="Duplicate" Command="{Binding DuplicateCommand}" ToolTip="Duplicate (Ctrl+D)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xF168;" Content="Group" Command="{Binding GroupCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xF169;" Content="Ungroup" Command="{Binding UngroupCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8E4;" Content="Align left" Command="{Binding AlignCommand}" CommandParameter="Left"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8E2;" Content="Align top" Command="{Binding AlignCommand}" CommandParameter="Top"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Insert">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Symbols" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE710;" Content="Insert selected" Command="{Binding InsertSymbolCommand}" ToolTip="Insert the symbol selected in the Symbol Browser (R rotate, X mirror)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE70F;" Content="Symbol editor" Command="{Binding OpenSymbolEditorCommand}"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Import" Style="{StaticResource RibbonGroup}" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8B5;" Content="DXF" Command="{Binding ImportDxfCommand}" ToolTip="Import DXF geometry into the active sheet"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8B5;" Content="Catalogue" Command="{Binding ImportCatalogCommand}" ToolTip="Import manufacturer products from CSV or Excel"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Engineering">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Automation" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8EF;" Content="Number wires" Command="{Binding NumberWiresCommand}" ToolTip="Assign wire numbers to unnumbered wires"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8EF;" Content="Renumber all" Command="{Binding NumberWiresCommand}" CommandParameter="all" ToolTip="Renumber all unlocked wires"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8CB;" Content="Renumber devices" Command="{Binding RenumberDevicesCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE895;" Content="Sync terminals" Command="{Binding SyncTerminalsCommand}"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Data" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE80A;" Content="Engineering data" Command="{Binding OpenEngineeringDataCommand}" ToolTip="BOM, cables, terminals, PLC I/O, motors, loads, cabinet layout"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE9D5;" Content="Validate" Command="{Binding ValidateCommand}"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Calculation">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Calculations" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8EF;" Content="Calculation workspace" Command="{Binding OpenCalculationsCommand}" ToolTip="Voltage drop, cable sizing, short circuit, transformer, motor, protection, loads"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE897;" Content="Methodology" Command="{Binding OpenHelpCommand}" CommandParameter="25-calculation-methodology"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Reports">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Documents" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE749;" Content="Drawing set PDF" Command="{Binding ExportDrawingsPdfCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE9F9;" Content="Reports…" Command="{Binding ExportReportsCommand}" ToolTip="BOM, lists, schedules, calculations in PDF, Excel or CSV"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE7B8;" Content="Handover package" Command="{Binding HandoverPackageCommand}"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Sheet exchange" Style="{StaticResource RibbonGroup}" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE78C;" Content="DXF" Command="{Binding ExportSheetCommand}" CommandParameter="dxf"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE78C;" Content="SVG" Command="{Binding ExportSheetCommand}" CommandParameter="svg"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xEB9F;" Content="PNG" Command="{Binding ExportSheetCommand}" CommandParameter="png"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Data exchange" Style="{StaticResource RibbonGroup}" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE943;" Content="JSON" Command="{Binding ExportDataCommand}" CommandParameter="json"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE943;" Content="XML" Command="{Binding ExportDataCommand}" CommandParameter="xml"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="View">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Drawing aids" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE80A;" Content="Grid" Command="{Binding ToggleSnapCommand}" CommandParameter="grid" ToolTip="F7"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE80A;" Content="Snap" Command="{Binding ToggleSnapCommand}" CommandParameter="snap" ToolTip="F9"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE80A;" Content="Object snap" Command="{Binding ToggleSnapCommand}" CommandParameter="osnap"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE80A;" Content="Ortho" Command="{Binding ToggleSnapCommand}" CommandParameter="ortho" ToolTip="F10"/>
                    </StackPanel></GroupBox>
                    <GroupBox Header="Appearance" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE793;" Content="Theme" Command="{Binding ToggleThemeCommand}"/>
                        <CheckBox Content="Advanced mode" IsChecked="{Binding AdvancedMode}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Brush.Text}"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Tools">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Tools" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE713;" Content="Settings" Command="{Binding OpenSettingsCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE70F;" Content="Symbol editor" Command="{Binding OpenSymbolEditorCommand}"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xEA86;" Content="Plugins" Command="{Binding ManagePluginsCommand}" ToolTip="Verify and trust plugins (administrators)"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8BD;" Content="Assistant" Command="{Binding OpenAssistantCommand}" ToolTip="Offline engineering assistant – never changes drawings without confirmation"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="Help">
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Help" Style="{StaticResource RibbonGroup}"><StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE897;" Content="Help center" Command="{Binding OpenHelpCommand}" ToolTip="F1"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE82D;" Content="Getting started" Command="{Binding OpenHelpCommand}" CommandParameter="01-introduction"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE765;" Content="Shortcuts" Command="{Binding OpenHelpCommand}" CommandParameter="03-interface-overview"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE789;" Content="What's new" Command="{Binding OpenHelpCommand}" CommandParameter="27-release-notes"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE8D7;" Content="Licensing" Command="{Binding OpenLicensingCommand}" ToolTip="Licence status, modules, activation and subscription"/>
                        <Button Style="{StaticResource RibbonButton}" Tag="&#xE946;" Content="About" Command="{Binding OpenAboutCommand}"/>
                    </StackPanel></GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ===================== Tutorial bar ===================== -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Tutorial}" Padding="12,6" Visibility="{Binding TutorialStep, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Help" Command="{Binding OpenHelpCommand}" CommandParameter="{Binding TutorialStep.HelpArticle}" Style="{StaticResource FlatButton}"/>
                    <Button Content="Next" Command="{Binding TutorialNextCommand}" Style="{StaticResource FlatButton}"/>
                    <Button Content="End tutorial" Command="{Binding TutorialCancelCommand}" Style="{StaticResource FlatButton}"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="{Binding TutorialTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" › "/><Run Text="{Binding TutorialStep.Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding TutorialStep.Text, Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Header}" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveDocument.CursorText}" Foreground="{DynamicResource Brush.HeaderText}" Margin="16,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveDocument.Title}" Foreground="#94A3B8" Margin="16,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Foreground="#94A3B8"><Hyperlink Command="{Binding OpenLicensingCommand}" Foreground="#94A3B8"><Run Text="{Binding LicenseStatusText, Mode=OneWay}"/></Hyperlink></TextBlock>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.HeaderText}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ===================== Workspace ===================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="200" MinHeight="90"/>
            </Grid.RowDefinitions>

            <!-- Left panel -->
            <TabControl Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}">
                <TabItem Header="Project" Style="{StaticResource PanelTab}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Margin="4" Text="{Binding Explorer.Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter the project explorer"/>
                        <TreeView x:Name="ExplorerTree" ItemsSource="{Binding Explorer.Roots}" MouseDoubleClick="ExplorerTree_MouseDoubleClick" Background="Transparent" BorderThickness="0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/></Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Width="20"/><TextBlock Text="{Binding Title}"/></StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Symbols" Style="{StaticResource PanelTab}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Margin="4" Text="{Binding Symbols.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search symbols (name, id, keyword – English and French)"/>
                        <ComboBox DockPanel.Dock="Top" Margin="4,0,4,4" ItemsSource="{Binding Symbols.Categories}" SelectedItem="{Binding Symbols.Category}"/>
                        <TextBlock DockPanel.Dock="Bottom" Margin="6" Style="{StaticResource Subtle}" TextWrapping="Wrap" Text="Double-click to place. R rotates, X mirrors, Esc ends."/>
                        <ListBox ItemsSource="{Binding Symbols.Results}" SelectedItem="{Binding Symbols.Selected}" MouseDoubleClick="Symbols_MouseDoubleClick"
                                 VirtualizingPanel.IsVirtualizing="True" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2" ToolTip="{Binding Description}">
                                        <Border Width="44" Height="44" Background="White" CornerRadius="3" Margin="0,0,8,0">
                                            <Image Source="{Binding Converter={StaticResource SymbolPreview}}" Stretch="Uniform" Margin="2"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Subtle}"><Run Text="{Binding Id, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Category, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Search" Style="{StaticResource PanelTab}" x:Name="SearchTab">
                    <ListBox ItemsSource="{Binding SearchResults}" MouseDoubleClick="SearchResults_MouseDoubleClick" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2"><TextBlock><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Layers" Style="{StaticResource PanelTab}">
                    <ItemsControl ItemsSource="{Binding Editor.Drawing.Layers}" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <CheckBox IsChecked="{Binding Visible}" ToolTip="Visible" Click="Layer_Changed"/>
                                    <CheckBox IsChecked="{Binding Locked}" ToolTip="Locked" Margin="6,0" Click="Layer_Changed"/>
                                    <CheckBox IsChecked="{Binding Printable}" ToolTip="Printable" Click="Layer_Changed"/>
                                    <TextBlock Text="{Binding Name}" Margin="8,0" ToolTip="{Binding Description}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Border}"/>

            <!-- Center: start page or documents -->
            <Grid Grid.Column="2">
                <TabControl x:Name="Documents" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}" Visibility="{Binding ShowStartPage, Converter={StaticResource InvBoolToVis}}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <Button Content="✕" Margin="8,0,0,0" Padding="2,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Brush.SubtleText}"
                                        Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:SheetEditorViewModel}">
                            <Grid>
                                <ctl:CadCanvas Editor="{Binding Editor}" Dark="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" OperationCompleted="Canvas_OperationCompleted"/>
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Padding="8,4" CornerRadius="4" Background="#CC172B4D">
                                    <TextBlock Text="{Binding Prompt}" Foreground="White" FontSize="12"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <ScrollViewer Visibility="{Binding ShowStartPage, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.Window}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="48,36" MaxWidth="1100">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/dnd-logo-256.png" Height="84" Margin="0,0,20,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="D&amp;D Electrical &amp; Automation Engineering Suite" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock Text="One Platform. Multiple Engineering Disciplines. Unlimited Possibilities." FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,2,0,2"/>
                                <TextBlock Text="{Binding PoweredBy}" Style="{StaticResource Subtle}" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="New project" Command="{Binding NewProjectCommand}" Style="{StaticResource AccentButton}" Padding="18,8"/>
                            <Button Content="Open project…" Command="{Binding OpenProjectCommand}" Style="{StaticResource FlatButton}" Padding="18,8"/>
                            <Button Content="Import archive…" Command="{Binding ImportArchiveCommand}" Style="{StaticResource FlatButton}" Padding="18,8"/>
                            <Button Content="Help center" Command="{Binding OpenHelpCommand}" Style="{StaticResource FlatButton}" Padding="18,8"/>
                        </StackPanel>
                        <Border Visibility="{Binding Recoverable.Count, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Brush.Tutorial}" CornerRadius="6" Padding="12" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Recoverable work (autosave found after an unexpected exit)" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Recoverable}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Command="{Binding DataContext.RecoverCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <TextBlock><Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  autosaved "/><Run Text="{Binding SavedAt, Mode=OneWay}"/></TextBlock>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,28,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Recent projects" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="No recent projects yet." Style="{StaticResource Subtle}" Visibility="{Binding RecentProjects.Count, Converter={StaticResource InvBoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding RecentProjects}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left" Content="{Binding}"
                                                Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Demonstration projects (fictional data)" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding DemoProjects}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Style="{StaticResource FlatButton}" HorizontalContentAlignment="Left" Padding="12,8"
                                                Command="{Binding DataContext.OpenDemoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Number}">
                                            <StackPanel>
                                                <TextBlock><Run Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" TextWrapping="Wrap" MaxWidth="460"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="© 2026 D&amp;D | Data&amp;Development. All rights reserved." Style="{StaticResource Subtle}" Margin="0,36,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Right panel: properties -->
            <GridSplitter Grid.Column="3" Grid.RowSpan="3" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Border}"/>
            <DockPanel Grid.Column="4" Grid.RowSpan="3" Background="{DynamicResource Brush.Panel}">
                <TextBlock DockPanel.Dock="Top" Text="Properties" Style="{StaticResource SectionTitle}" Margin="10,8,10,0"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding PropertiesTitle}" Style="{StaticResource Subtle}" Margin="10,0,10,8" TextWrapping="Wrap"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Properties}" Margin="8,0" x:Name="PropertyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding Category}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"
                                             LostKeyboardFocus="Property_LostFocus" KeyDown="Property_KeyDown"
                                             Visibility="{Binding Options, Converter={StaticResource InvBoolToVis}}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"
                                              LostKeyboardFocus="Property_LostFocus" KeyDown="Property_KeyDown" DropDownClosed="Property_DropDownClosed"
                                              Visibility="{Binding Options, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Bottom panel -->
            <GridSplitter Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Brush.Border}"/>
            <TabControl Grid.Row="2" Grid.Column="2" x:Name="BottomTabs">
                <TabItem Header="Command line" Style="{StaticResource PanelTab}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="{Binding CommandLine.Prompt}" VerticalAlignment="Center" Margin="6,0" Style="{StaticResource Subtle}" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="CommandBox" Text="{Binding CommandLine.Input, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" KeyDown="CommandBox_KeyDown"
                                     ToolTip="Commands: LINE, PL, C, A, REC, T, DIM, WIRE, INSERT &lt;id&gt;, MOVE, COPY, ROTATE, ERASE, ZE, GRID, SNAP, ORTHO, NUMBER, VALIDATE, HELP · coordinates: x,y  @dx,dy  @dist&lt;angle"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding CommandLine.History}" FontFamily="Consolas" Background="Transparent" BorderThickness="0"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Validation" Style="{StaticResource PanelTab}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                            <Button Content="Validate (F8)" Command="{Binding ValidateCommand}" Style="{StaticResource FlatButton}"/>
                            <CheckBox Content="Show information messages" IsChecked="{Binding Validation.ShowInfos}" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="{Binding Validation.Summary}" VerticalAlignment="Center" Margin="8,0"/>
                        </StackPanel>
                        <DataGrid x:Name="ValidationGrid" ItemsSource="{Binding Validation.Issues}" SelectedItem="{Binding Validation.Selected}" MouseDoubleClick="ValidationGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Go to object" Click="ValidationGoTo_Click"/>
                                    <MenuItem Header="Apply suggested correction…" Click="ValidationFix_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Severity">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Severity}" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}"/>
                                <DataGridTextColumn Header="Object" Binding="{Binding ObjectRef}"/>
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                                <DataGridTextColumn Header="Suggested correction" Binding="{Binding Suggestion}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Output" Style="{StaticResource PanelTab}">
                    <ListBox ItemsSource="{Binding Output}" FontFamily="Consolas" Background="Transparent" BorderThickness="0"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
